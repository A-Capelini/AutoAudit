# Copie este arquivo para ".env" e ajuste os valores.
# .env nunca deve ser commitado (já está no .gitignore).

# --- MongoDB ---
MONGO_ROOT_USER=autoaudit
MONGO_ROOT_PASS=troque_esta_senha
MONGO_DB_NAME=autoaudit
MONGO_URI=mongodb://autoaudit:troque_esta_senha@localhost:27017/autoaudit?authSource=admin

# --- NVD (CVE) API ---
# Opcional para começar: sem chave, o limite é 5 requisições/30s.
# Com chave gratuita, sobe para 50 requisições/30s.
# Registro gratuito: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- LLM (motor de PLN) ---
# Preencha conforme o provedor escolhido (ex.: chave da OpenAI/Anthropic,
# ou deixe em branco se for usar um modelo local via Ollama).
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (FAISS) ---
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
